# Copy to backend/.env for local dev. NEVER commit the real .env.
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_URL=postgresql+psycopg://pushblog:pushblog@localhost:5432/pushblog
CORS_ORIGINS=http://localhost:5173

# local | s3
STORAGE_BACKEND=local
# --- only needed when STORAGE_BACKEND=s3 ---
S3_BUCKET=
S3_REGION=ap-south-1
S3_PUBLIC_BASE_URL=
